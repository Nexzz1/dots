
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch",
    "padding": {
      "top": 1,
      "left": 4,
      "bottom": 0
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "\uf108 ",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": ">_",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "\ue795 ",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "\uf2d0 ",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "󰍛 ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "🎟 ",
      "format": "{used} / {total}"
    },
    {
      "type": "uptime",
      "key": "\uf017 "
    },
    {
      "type": "disk",
      "key": "\uf073 ",
      "folders": "/",
      "format": "{used} / {total} ({percentage})"
    },
    "break"
  ]
}
