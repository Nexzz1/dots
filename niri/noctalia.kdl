layout {

    focus-ring {
        active-color   "#a5c9f9"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a5c9f9"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#a5c9f9"
        inactive-color "#7ea2d0"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a5c9f980"
    }
}

recent-windows {
    highlight {
        active-color "#a5c9f9"
        urgent-color "#ffb4ab"
    }
}
